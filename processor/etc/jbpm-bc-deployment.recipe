echo 'Building Postgres container'
source pre:///$repo_home/sales-analyzer-postgres.recipe


echo 'Building Keycloak container'
source pre:///$repo_home/sales-analyzer-keycloak.recipe


c2 = tura:docker findContainer --name jbpm-bc
echo 'Wildfly container located? '$c2

if { %(c2) } { 
     echo '  Stop container '
     tura:docker stopContainer --name jbpm-bc
     echo ' Remove container '
     tura:docker removeContainer --name jbpm-bc
} {
   c2 = tura:docker findImage --registry tura/jbpm/bc --tag 1.0
   if { %(c2) } { } {
   
   echo 'Building wildfly container'
   source pre:///$repo_home/jbpm-bc-start-server.recipe
   
   }
}
 
 source pre:///$repo_home/jbpm-bc-redeploy-server.recipe
