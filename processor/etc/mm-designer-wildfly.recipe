mr2 = tura:dsl config --mavenRepositoryLocation

tura:docker stopContainer --name ${mm_wf_cnt_name}

tura:docker removeContainer --name ${mm_wf_cnt_name}

tura:docker removeImage --registry tura/metamodel/wildfly --tag 1.0

tura:docker pullImage --registry jboss/wildfly --tag ${wildfly_version}

tura:docker createNetwork --network ${mm_network}

c = tura:docker config --user 0 

v = tura:docker createContainer --registry jboss/wildfly --tag ${wildfly_version} --var c

tura:dsl jbossModule\
                 --container $v\
                 --configPath postgres/docker\
                 --jboss_home /opt/jboss/wildfly\
                 --application metamodel\
                 --serverType wildfly-${wildfly_version}\
                 --relativeLocation org/postgresql/main

tura:dsl copyRoles\
                --container $v\
                --jboss_home /opt/jboss/wildfly\
                --application metamodel\
                --serverType wildfly-${wildfly_version}

tura:dsl copyUsers\
                --container $v\
                --jboss_home /opt/jboss/wildfly\
                --application metamodel\
                --serverType wildfly-${wildfly_version}

tura:dsl copyFile\
                --container $v\
                --targetLocation /opt/jboss/wildfly/modules/org/postgresql/main\
                --sourceResource $mr2/org/postgresql/postgresql/42.1.1/postgresql-42.1.1.jar 

tura:dsl generateArtifact\
             --templateLocation metamodel/wildfly-${wildfly_version}/assets/wf-config.cli\
             --artifactTargetLocation $tura_working_directory/resources\
             --artifactName wf-config.cli\
             --property mm_postgres_cnt_name:${mm_postgres_cnt_name}

tura:dsl copyFile\
                --container $v\
                --targetLocation /opt/jboss/wildfly/bin\
                --sourceResource $tura_working_directory/resources/wf-config.cli


tura:dsl exec --cmd "docker exec -i  $v  sh -c \" /opt/jboss/wildfly//bin/jboss-cli.sh  --file=/opt/jboss/wildfly//bin/wf-config.cli\""


tura:docker stopContainer --id $v

tura:docker commitContainer\
                --registry tura/metamodel/wildfly\
                --tag 1.0\
                --id $v\
                --cmd "/opt/jboss/wildfly/bin/standalone.sh --debug *:3333 -c standalone-full.xml -b 0.0.0.0"


tura:docker removeContainer --id $v




