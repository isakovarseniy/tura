mr2 = tura:dsl config --mavenRepositoryLocation

c = tura:docker config\
                --port 8080:8080\
                --port 3333:3333\
                --port 8443:8443\
                --network ${mm_network}\
                --var JAVA_OPTS="-Xms64m -Xmx1g -XX:MetaspaceSize=96M -XX:MaxMetaspaceSize=1024m -Djava.net.preferIPv4Stack=true -Djboss.modules.system.pkgs=org.jboss.byteman -Djava.awt.headless=true"
                

v = tura:docker createContainer --registry tura/metamodel/wildfly --tag 1.0 --var c --name ${mm_wf_cnt_name}


tura:dsl copyFile               --container $v\
                                          --targetLocation  /opt/jboss/wildfly/\
                                          --targetName windPlugins.json\
                                          --sourceResource $repo_home/metamodel/assets/windPlugins.json       


tura:dsl jbossDoDeploy --container $v\
                                     --jboss_home /opt/jboss/wildfly\
                                     --targetName mm-object-repository-${tura_version}.war\
                                    --srcResource $mr2/org/tura/model-designer/mm-object-repository/${tura_version}/mm-object-repository-${tura_version}.war


tura:dsl jbossDoDeploy --container $v\
                                     --jboss_home /opt/jboss/wildfly\
                                     --targetName mm-frame-${tura_version}.war\
                                    --srcResource $mr2/org/tura/model-designer/ui/mm-frame/${tura_version}/mm-frame-${tura_version}.war


tura:dsl jbossDoDeploy --container $v\
                                      --jboss_home /opt/jboss/wildfly\
                                      --targetName mm-frame-client-${tura_version}.war\
                                      --srcResource $mr2/org/tura/model-designer/ui/mm-frame-client/${tura_version}/mm-frame-client-${tura_version}.war

                                      
                                      
