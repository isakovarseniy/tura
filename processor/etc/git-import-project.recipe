tura:docker jbpm createSpace\
                           --bc-host-port localhost:${business_center_http}\
                           --kc-host-port kc:8080\
                           --realm sales-analyzer\
                           --clientId service-access\
                           --user $user\
                           --password $password\
                           --space $space
                           

tura:docker jbpm removeProject\
                           --bc-host-port localhost:${business_center_http}\
                           --kc-host-port kc:8080\
                           --realm sales-analyzer\
                           --clientId service-access\
                           --user $user\
                           --password $password\
                           --space $space\
                           --projectName $project

tura:docker jbpm createProject\
                           --bc-host-port localhost:${business_center_http}\
                           --kc-host-port kc:8080\
                           --realm sales-analyzer\
                           --clientId service-access\
                           --user $user\
                           --password $password\
                           --space $space\
                           --projectName  $project\
                           --version $tura_version\
                           --groupId=$groupId


tura:dsl removeFile --targetLocation  $tura_working_directory/$groupId/$project-$opensource_branch
tura:dsl removeFile --targetLocation  $tura_working_directory/$groupId/${project}_tmp
tura:dsl removeFile --targetLocation  $tura_working_directory/$groupId

tura:dsl gitClone\
                           --password $password\
                           --remote ssh://$user@localhost:${business_center_git}/$space/$project\
                           --outputFilePath $tura_working_directory/$groupId/$project-$opensource_branch
                           

tura:dsl gitArchive --branch $opensource_branch --localRepositoryPath $localRepositoryPath --outputFilePath $tura_working_directory/$groupId/${project}_tmp


tura:dsl copyDir\
         --sourceResource $tura_working_directory/$groupId/${project}_tmp/$localProcessProjectLocation\
         --targetLocation $tura_working_directory/$groupId/$project-$opensource_branch
         

tura:dsl gitAddAndCommit\
                      --localRepositoryPath $tura_working_directory/$groupId/$project-$opensource_branch


tura:dsl gitPush\
                      --password $password\
                      --localRepositoryPath $tura_working_directory/$groupId/$project-$opensource_branch
