[%
 @template
operation beanFactoryInitializer( hash){
     var util = new Native('org.tura.metamodel.commons.Util');
     var form = hash.get("form");
     var uipackage = hash.get("uipackage");
     var beanFactoryName  =  hash.get("beanFactoryName");
     
%]

package  [%=component.basePackage%].[%=util.mergeAndCapitalize(uipackage.name).toLowerCase()%].[%=util.mergeAndCapitalize(form.name).toLowerCase()%].datacontrol;  

@org.tura.platform.datacontrol.annotations.FormInitialization
(
form="[%=util.mergeAndCapitalize(uipackage.name).toLowerCase()%].[%=util.mergeAndCapitalize(form.name).toLowerCase()%]",
expression = "#{beanFactory[%=beanFactoryName%].init()}"
)
public class FormBeanFactoryInitialization {

}

[%
}
%]