%]
[%
 import "tura:/generation-templates/template/commons/typeElementUtil.eol";
 import "tura:/generation-templates/template/commons/categorizedUtil.eol";
 
 @template
 operation entitypk(hash){
 
 var type =  hash.get("type");
 var recipe = hash.get("recipe");
 var ingredient =  hash.get("ingredient");
 var component = hash.get("component");
 var model_mapper = hash.get("model_mapper");
 var path = hash.get("path");
 var configuration =  hash.get("configuration");    
 
 
 var util = new Native('org.tura.metamodel.commons.Util');
%]
package [%=type.~package%];  

public class [%=type.~class%]PK implements java.io.Serializable, org.tura.platform.repository.neo4j.operation.FilterBuilder{

	private static final long serialVersionUID = 1L;


   public [%=type.~class%]PK(){
   }
   
   
   public [%=type.~class%]PK(
        [% 
        var comma =false;
         for (field in type.~primaryKey){
            field.typeRef.mappingType2Java(recipe,ingredient);
            var fieldName = util.mergeAndUnCapitalize(field.name);
           %]
              [%if ( comma){%],[%} %] [%=field.typeRef.~fullName%] [%=fieldName%]
           [% 
           comma = true;
         }
     
     %]
   ){
        [% 
         for (field in type.~primaryKey){
            field.typeRef.mappingType2Java(recipe,ingredient);
            var fieldName = util.mergeAndUnCapitalize(field.name);
            
           %]
                this.[%=util.mergeAndUnCapitalize(field.name)%] = [%=fieldName%];
           [% 
         }
     %]
   }   
   

     [% 
         for (field in type.~primaryKey){
            var fieldName = util.mergeAndUnCapitalize(field.name);
           %]
           private [%=field.typeRef.~fullName%] [%=util.mergeAndUnCapitalize(fieldName)%]; 
           [% 
         }
     
     %]
     

     [% 
         for (field in type.~primaryKey){
            var fieldName = util.mergeAndUnCapitalize(field.name);
           %]
           public void set[%=util.mergeAndCapitalize(field.name)%]( [%=field.typeRef.~fullName%] [%=fieldName%]){
               this.[%=fieldName%]=[%=fieldName%];
           } 
           
           public [%=field.typeRef.~fullName%] get[%=util.mergeAndCapitalize(field.name)%]( ){
               return [%=fieldName%];
           } 
           [% 
         }
     
     %]
     
   @Override
    public boolean equals(Object obj) {
        if(obj instanceof [%=type.~package%].[%=type.~class%]PK){
            [%=type.~package%].[%=type.~class%]PK type = ([%=type.~package%].[%=type.~class%]PK) obj;
 
      [% 
         for (field in type.~primaryKey){
            var fieldName = util.mergeAndUnCapitalize(field.name);
         
           %]
            if(!type.get[%=util.mergeAndCapitalize(field.name)%]( ).equals([%=fieldName%])){
                return false;
            }
           [% 
         }
     %]
            return true;
        }
 
        return false;
    }

    @Override
    public int hashCode() {
         int i = 0;
        [% 
         for (field in type.~primaryKey){
            var fieldName = util.mergeAndUnCapitalize(field.name);
         
           %]
           i = i +[%=fieldName%].hashCode();
           [% 
         }
     %]
        return i;
    }

    public boolean isNull(){
         boolean r = true;
        [% 
         for (field in type.~primaryKey){
            var fieldName = util.mergeAndUnCapitalize(field.name);
         
           %]
           r = r &([%=fieldName%] == null);
           [% 
         }
     %]
        return r;    
    
    }


    @Override
    public String toString() {
         String str = "[%=type.~package%].[%=type.~class%]PK";
        [% 
         for (field in type.~primaryKey){
            var fieldName = util.mergeAndUnCapitalize(field.name);
         
           %]
           str = str +" [%=fieldName%] = " +[%=fieldName%].toString();
           [% 
         }
     %]
        return str;
    }
    
    @Override
   public org.neo4j.ogm.cypher.Filters getPKSearch(){
        org.neo4j.ogm.cypher.Filters filters = new org.neo4j.ogm.cypher.Filters();
        [% 
         for (field in type.~primaryKey){
			    var column_name=  util.splitByCapitalLatterAndCapitalize(field.name);  
                 var fieldName = util.mergeAndUnCapitalize(field.name);
			    
			    if (field.findClassifier(util.getHint(model_mapper,"Column"))){
			       column_name=field.~hintDetails;
			    }
         
         
           %]
               filters.add(  new org.neo4j.ogm.cypher.Filter("[%=column_name%]", org.neo4j.ogm.cypher.ComparisonOperator.EQUALS, this.[%=fieldName%]));
           [% 
         }
     %]
        return filters;
        
   }


}
[%}%]

