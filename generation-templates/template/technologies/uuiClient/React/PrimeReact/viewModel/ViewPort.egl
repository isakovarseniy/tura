[%@template
operation form::ViewPort createModel(hash) { 
     var util = new Native('org.tura.metamodel.commons.Util');
     var model_mapper = hash.get('model_mapper');

     var modelRegistration = hash.get("modelRegistration");
     modelRegistration.add(self);


     if (self.findClassifier(util.getHint(model_mapper,"WindowPluginPort"))){
        self.createModelAsWindowPlugin(hash);
     }else{
        self.createModelAsSimpleViewPort(hash);
     }

}


operation form::ViewPort className(hash) { 
   return self.eClass().getName();
}

%]