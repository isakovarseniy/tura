# Generates completions for the options and subcommands of the `tura` command.
function _picocli_tura() {
  # Get completion data
  local curr_word=${COMP_WORDS[COMP_CWORD]}

  local commands="keyCloak container wildfly model neo4j postgreSQL setup"
  local flag_opts=""
  local arg_opts=""

  if [[ "${curr_word}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${flag_opts} ${arg_opts}" -- "${curr_word}") )
  else
    local positionals=""
    local IFS=$'\n'
    COMPREPLY=( $(compgen -W "${commands// /$'\n'}${IFS}${positionals}" -- "${curr_word}") )
  fi
}

